// List and dict errors (INTERNALS 5.5, 5.11).
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message)
    }
}
let d = {name: 1}
show(func() => d.nmae)
show(func() => d["x"])
show(func() => d[1])
show(func() => d.remove("zzz"))
show(func() => d.get(1))
show(func() => d.frobnicate())
show(func() => {[1]: 2})
show(func() => [1].len)
show(func() => [1].len())
show(func() => d.len())
show(func() => [1].append(2))
show(func() => [].pop())
show(func() => [1, 2][5])
show(func() => [1, 2][-3])
show(func() => [1, 2]["0"])
show(func() => [1, 2].pop(-3))
show(func() => [1, 2].get("a"))
show(func() => [1, "a"].sort())
show(func() => [[1]].sort())
show(func() => [1].map(func(a, b) => a))
show(func() => [1].join(0))
show(func() => null.x)
show(func() => null.x())
show(func() => null[0])
let n = 5
show(func() => n.x)
show(func() => n.x())
show(func() => n[0])
show(func() => n[0:1])
let xs = [1, 2]
try {
    xs[2] = 3
} catch (e) {
    print(e.type + ": " + e.message, xs)
}
try {
    n.field = 1
} catch (e) {
    print(e.type + ": " + e.message)
}
let nothing = null
try {
    nothing.field = 1
} catch (e) {
    print(e.type + ": " + e.message)
}
