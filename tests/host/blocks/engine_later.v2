// Tags of engines this build does not have yet say so, before any did-you-mean: `@rs` is Rust,
// not a typo of `@ts`; another tag says how to declare a custom engine, and a declared engine
// whose program isn't there is EngineNotFound, naming where it was declared (INTERNALS 7.3, 7.4,
// 17.2, DOCS 5, 13).
try {
    @c { int x = 1; }
} catch (e) {
    print(e.type, e.message)
}
try {
    @rs { let x = 1; }
} catch (e) {
    print(e.message)
}
try {
    @r { cat(1) }
} catch (e) {
    print(e.message)
}
define_engine("r", kind: "run", command: ["v2-no-such-rscript", "{file}"])
try {
    @r { cat(1) }
} catch (e) {
    print(e.type, e.message)
}
print(engine_available("cpp"), engine_available("r"), engine_available("nosuch"))
