// Operator errors (INTERNALS 5.3): overflow and division by zero are ValueErrors.
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message)
    }
}
show(func() => 9223372036854775807 + 1)
show(func() => -9223372036854775807 - 2)
show(func() => 4611686018427387904 * 2)
show(func() => 2 ** 63)
show(func() => -(-9223372036854775807 - 1))
show(func() => 1 / 0)
show(func() => 1 % 0)
show(func() => 1.5 % 0.0)
show(func() => 0 ** -1)
show(func() => "a" + 1)
show(func() => 1 - "a")
show(func() => [1] * "a")
show(func() => [1] < [2])
show(func() => "a" < 1)
show(func() => -"a")
show(func() => 1 in 5)
show(func() => 1 in "abc")
print(1 in {a: 1}, "a" in {a: 1})      // not a key: false (5.3)
show(func() => "ab" * 9223372036854775807)
let total = 9223372036854775807
try {
    total += 1
} catch (e) {
    print(e.type + ": " + e.message, total)
}
