// Import errors (INTERNALS 6.4): missing files, cycles, and a module that throws.
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message)
        return e
    }
}
show(func() {
    import "./fixtures/nope.v2" as nope
})
show(func() {
    import "./fixtures/cyc_a.v2" as a
})
let first = show(func() {
    import "./fixtures/boom.v2" as boom
})
print(first.trace)
let second = show(func() {
    import "./fixtures/boom.v2" as boom
})
print(first == second)
show(func() {
    import "./errors.v2" as me
})
// A failed module never runs again: importing a cycle member re-raises its stored error.
show(func() {
    import "./fixtures/cyc_a.v2" as a
})
show(func() {
    import "./fixtures/cyc_b.v2" as b
})
