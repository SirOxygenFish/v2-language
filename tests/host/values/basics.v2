// Truthiness, sharing and constants (DOCS 3.2, 3.3, INTERNALS 5.2, 5.6).
for v in [null, false, 0, 0.0, -0.0, "", b"", [], {}] {
    print(!v, v ? "truthy" : "falsy")
}
let inf = 1e308 * 10
for v in [true, 1, -1, 0.5, inf - inf, "0", " ", b"\x00", [0], {a: null}, func() => 1, error("E", "m"), print] {
    print(!!v)
}
// Lists and dicts are shared, not copied.
let a = [1, 2]
let b = a
b.push(3)
print(a)
let c = a.copy()
c.push(4)
print(a, c)
let xs = [1]
let ys = xs
xs += [2]
print(xs, ys)
func add_item(list) {
    list.push("added")
}
add_item(a)
print(a)
// const stops reassignment, not mutation.
const LIMIT = 10
const ITEMS = []
ITEMS.push(1)
print(LIMIT, ITEMS)
try {
    LIMIT = 11
} catch (e) {
    print(e.type + ": " + e.message)
}
try {
    LIMIT += 1
} catch (e) {
    print(e.type + ": " + e.message)
}
let nothing
print(nothing)
let shadow = "outer"
func reads_outer() {
    return shadow
}
shadow = "changed"
print(reads_outer())
