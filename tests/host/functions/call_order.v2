// The callee is resolved before the arguments run, for methods too (INTERNALS 5.7).
let d = {f: lambda(x) => "old f"}
func swap() {
    d.f = lambda(x) => "new f"
    return 0
}
print(d.f(swap()))
let g = lambda(x) => "old g"
func swap_g() {
    g = lambda(x) => "new g"
    return 0
}
print(g(swap_g()))
let e = {}
func add() {
    e.get = lambda(x) => "key func"
    return "missing"
}
print(e.get(add()))
func noisy() {
    print("argument ran")
    return 0
}
let n = null
try { n.x(noisy()) } catch (err) { print(err.message) }
try { [].frobnicate(noisy()) } catch (err) { print(err.message) }
// Documented parameter names bind by name (DOCS 3.5, 3.6).
let xs = [1, 2]
xs.push(x: 3)
xs.insert(i: 0, x: 0)
print(xs.get(i: 1), xs.get(i: 9, default: "none"), xs.index_of(x: 3), xs.remove_at(i: 0), xs)
let m = {a: 1}
print(m.get(k: "a"), m.get(k: "b", default: 0), m.remove(k: "a"), m)
print("ab".starts_with(p: "a"), "ab".ends_with(p: "b"), "a,b".split(sep: ","), "aa".replace(old: "a", new: "b"))
// Repeating an empty value is instant at any count.
print("" * 9223372036854775807 == "", [] * 9223372036854775807, [1] * 0)
