// Strings are indexed by character (DOCS 3.5, INTERNALS 5.4, 5.11).
let s = "héllo"
print(s[1], s[-1], s[1:3], s[:2], s[3:], s[-3:], s[10:] == "", s[3:1] == "", s.len())
print("hello"[1:3], "abc"[-5:2], "abc"[:], "😀x"[0], "😀x"[1])
for ch in "héy" { print(ch) }
for i, ch in "ab" { print(i, ch) }
print("Hello World".lower(), "straße".upper(), "  pad \t\n".trim() + "|")
print("a,b,,c".split(","), "one\ntwo\r\nthree\n".lines(), "a::b".split("::"))
print("aaa".replace("a", "b"), "hello".starts_with("he"), "hello".ends_with("lo"), "x".starts_with(""))
print("héllo wörld".find("wö"), "abc".find("z"), "abc".find(""), "é".encode(), b"h\xc3\xa9".decode(), b"\x01\xab".hex())
let long = "é" * 100 + "x" + "a" * 100
print(long.len(), long[100], long.find("x"), long[99:102], long[-1])
let price = 19.999
print(f"${price:.2f}", f"${2:.3f}", f"${1 + 1}", f"${[1, "a"]}", f"${"plain"}")
let b = b"hi!"
print(b[0], b[-1], b[1:], b"" == b[5:])
