// String and bytes errors (INTERNALS 5.4, 5.5, 5.11).
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message)
    }
}
show(func() => "abc"[5])
show(func() => "abc"[-4])
show(func() => "abc"[1.0])
show(func() => "abc"["x"])
show(func() => "abc".frobnicate())
show(func() => "abc".uper())
show(func() => "abc".len)
show(func() => "abc".len())
show(func() => "a,b".split(""))
show(func() => "a".replace("", "x"))
show(func() => "abc".split(1))
show(func() => "abc".upper(1))
show(func() => b"\xff".decode())
show(func() => b"ab"[2])
show(func() => b"ab".len())
show(func() => "abc"[1:"x"])
show(func() => f"${"x":.2f}")
let s = "abc"
try {
    s[0] = "z"
} catch (e) {
    print(e.type + ": " + e.message)
}
// decode() and encode() are UTF-8 only: the hint says how a block does another encoding, for
// bytes that aren't UTF-8 and for any argument (round 20).
func hint(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message)
        print("  hint: " + e.hint)
    }
}
hint(func() => b"G\xfc\xdfe".decode())
hint(func() => b"x".decode("latin-1"))
hint(func() => b"x".decode(encoding: "latin-1"))
hint(func() => b"x".decode(errors: "replace"))
hint(func() => "ü".encode("cp1254"))
hint(func() => "ü".encode(encoding: "cp1254"))
// Asked for UTF-8, as Python writes it: the argument goes (the second review of round 20).
hint(func() => b"x".decode("utf-8"))
hint(func() => b"x".decode("UTF8"))
hint(func() => b"x".decode(encoding: "Utf-8"))
hint(func() => b"x".decode("utf-8", "ignore"))
hint(func() => "x".encode("UTF-8"))
hint(func() => "x".encode(encoding: "utf8"))
print(b"G\xc3\xbc".decode())
print(len("Gü".encode()))
