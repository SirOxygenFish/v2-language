// A name typed without its accents is suggested, as one in another case is (INTERNALS 5.9,
// round 20): ß as ss and two accents in a short name were past the distance.
let größe = 1
let büyüt = 2
let yardım = 3
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.message)
    }
}
show(func() => grosse)
show(func() => buyut)
show(func() => yardim)
// Other letters still count.
show(func() => buyuk)
// A key in another Unicode form (decomposed) looks like the one typed, so it isn't suggested
// (round 20's review); typed without the accent, it still is.
let d = {"cafe\u{301}": 1}
show(func() => d["caf\u{e9}"])
show(func() => d["cafe"])
// A long one too: its decomposed letter is 2 edits, within the distance (round 20, third pass).
let long = {"u\u{308}ber_alles": 1, "gro\u{308}\u{df}en": 2}
show(func() => long["\u{fc}ber_alles"])
show(func() => long["gr\u{f6}\u{df}en"])
