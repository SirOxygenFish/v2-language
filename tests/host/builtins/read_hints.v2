// requires: py
// The blocks that read_file's hints show work as written (INTERNALS 5.10): the first and the last
// MiB of a file too big to read whole, and a log whose last character is cut, without it.
let home = getenv("HOME") ?? getenv("USERPROFILE")
let path = home + "/v2_read_hints.bin"
write_file(path, "h" + "a" * (3 * 1048576) + "t")
let first = @py(path) { open(path, "rb").read(1 << 20) }
let last = @py(path) { f = open(path, "rb"); f.seek(-(1 << 20), 2); f.read() }
print(type(first), len(first), first[0], len(last), last[len(last) - 1])
write_file(path, b"started in \xc5\x81\xc3\xb3d\xc5\xba\r\nuser \xc5")
print(json_stringify(@py(path) { open(path, encoding="utf-8", errors="ignore", newline="").read() }))
