// min, max, sum, abs, round and div (DOCS 3.11, INTERNALS 5.10).
func show(f) {
    try {
        print(f())
    } catch (e) {
        print(e.type + ": " + e.message)
    }
}
// min and max: the arguments, or the items of a single list; the first wins a tie.
print(min(3, 1, 2), max(3, 1, 2), min([4, 2.5, 9]), max(["pear", "apple", "zoo"]))
print(min(1, 1.0), min(1.0, 1), max(2, 2.0), max([7]), min("b", "a", "c"))
print(type(min(1, 1.0)), type(max(2.0, 2)))
show(func() => min())
show(func() => max([]))
show(func() => min(1, "a"))
show(func() => max([1, [2]]))
show(func() => min([1], [2]))
show(func() => min(null))
// sum: from 0, left to right with +; a float makes the result a float.
print(sum([1, 2, 3]), sum([1, 2.5]), sum([]), type(sum([])), sum([0.1, 0.2]))
// From 0, left to right: (0.1 + 0.2) + 0.3, and 0 + -0.0 is 0.0.
print(sum([0.1, 0.2, 0.3]), sum([0.3, 0.2, 0.1]), sum([-0.0]))
show(func() => sum([1, "2"]))
show(func() => sum(5))
show(func() => sum([9223372036854775807, 1]))
// abs
print(abs(-3), abs(3), abs(-2.5), abs(0), abs(-0.0))
show(func() => abs(-9223372036854775807 - 1))
show(func() => abs("1"))
// round: as f"${x:.Nf}" prints it, ties to even; digits 0 gives an int.
print(round(2.5), round(3.5), round(-2.5), round(0.5), round(2.675, 2), round(1.005, 2))
print(round(7), round(7, 3), round(2.0), type(round(2.0)), round(1.25, 1), type(round(1.25, 1)))
print(round(-0.4), round(123.456, 1), round(1e20, 1), round(0.1, 400))
// From 324 digits on, x comes back unchanged without formatting it.
print(round(1.5, 324), round(0.1, 9223372036854775807))
show(func() => round(2.5, -1))
show(func() => round(1e300))
show(func() => round(float("nan")))
show(func() => round(float("inf")))
show(func() => round("1"))
show(func() => round(1.5, 1.0))
print(round(float("inf"), 2), round(float("nan"), 1))
// div: rounded down, so div(a, b) * b + a % b == a.
print(div(7, 2), div(-7, 2), div(7, -2), div(-7, -2), div(6, 3), div(-6, 3), div(0, 5))
for a in [-7, -6, 7, 6, 0] {
    for b in [2, -2, 3, -3] {
        if div(a, b) * b + a % b != a { print("broken for", a, b) }
    }
}
show(func() => div(1, 0))
show(func() => div(-9223372036854775807 - 1, -1))
show(func() => div(1.0, 2))
show(func() => div(1, "2"))
