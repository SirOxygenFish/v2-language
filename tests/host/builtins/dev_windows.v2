// platform: windows
// /dev/stdin and the others are Linux's and macOS's names: on Windows the hint says what to use
// instead (DOCS 3.11).
try {
    read_file("/dev/stdin")
} catch (e) {
    print(e.message)
    print(e.hint)
}
// A ':' after the drive names a hidden stream on Windows: refused before anything is written.
try {
    write_file("notes 12:30.txt", "x")
} catch (e) {
    print(e.message)
    print(e.hint, exists("notes 12"))
}
