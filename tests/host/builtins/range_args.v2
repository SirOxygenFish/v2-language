// `null` is an argument like any other: only a missing `end` is an ArityError (5.10).
func show(f) {
    try {
        print(f())
    } catch (e) {
        print(e.type, "|", e.message)
    }
}
show(func() => range(null))
show(func() => range(3, null))
show(func() => range(null, 3))
show(func() => range(0, null, 1))
show(func() => range(0, 3, null))
show(func() => range())
show(func() => range(1, 2, 3, 4))
show(func() => range(end: 3))
show(func() => range(3))
show(func() => range(1, 3))
show(func() => range(10, 0, -3))
