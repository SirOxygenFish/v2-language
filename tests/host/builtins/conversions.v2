// Conversions and inspection (DOCS 3.11, INTERNALS 5.10).
print(len("héllo"), len(b"ab"), len([1, 2, 3]), len({a: 1}), len(""))
print(type(null), type(true), type(1), type(1.5), type("s"), type(b""), type([]), type({}), type(print), type(lambda() => 1), type(error("E", "m")))
print(str(3.5), str([1, "a"]), str(null) + "!", str("plain"))
print(int(3.9), int(-3.9), int(" 42 "), int("+7"), int("-0"), int(true), int(9223372036854775807))
print(float(3), float(" 2.5 "), float("1e3"), float("inf"), float("-Infinity"), float("NaN"), float(false))
print(bool(0), bool(""), bool([]), bool([0]), bool(0.0), bool("0"))
print(range(4), range(2, 5), range(10, 0, -3), range(0, 10, 4), range(5, 2), range(0))
print(range(end: 3), range(1, end: 3), range(2, 8, step: 3))
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message)
    }
}
show(lambda() => int("abc"))
show(lambda() => int("1_000"))
show(lambda() => int("99999999999999999999"))
show(lambda() => int(1e300))
show(lambda() => int(float("nan")))
show(lambda() => int([1]))
show(lambda() => float("x1"))
show(lambda() => float(null))
show(lambda() => len(5))
show(lambda() => range(1, 2, 0))
show(lambda() => range(1.5))
show(lambda() => range())
show(lambda() => range("a", 2))
show(lambda() => range(0, 9223372036854775807))
show(lambda() => type())
