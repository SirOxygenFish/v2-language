// int() and float() of the text a student types, with what the text needs to be (DOCS 3.11,
// INTERNALS 5.10).
func try_it(f) {
    try { f() } catch (e) { print(e.type, "|", e.message); print("  hint:", e.hint) }
}
for t in ["13.5", "13.5 kg", "13 Jahre", "dreizehn", " 7 ", "", "0x1F"] {
    try_it(func() => int(t))
}
for t in ["3,7", "2,5 kg", "abc", "1.5e3"] {
    try_it(func() => float(t))
}
try_it(func() => int(null))
// Separators and digits of other scripts: what removes them, never "drop the rest".
for t in ["1_000", "12 345", "1.234,56", "15.655.924", "١٢٣", "１２"] {
    try_it(func() => int(t))
}
try_it(func() => float("0x1f"))
// Numbers as locales write them (round 20): the separator named in the replace, which works.
for t in ["1.234", "1,234", "1'000", "1\u{a0}234"] {
    try_it(func() => int(t))
}
for t in ["1\u{202f}234,5", "1'234.5", "1,234.56", "\u{2212}5", "\u{2212}0,5", "12\u{66b}5", "1,234"] {
    try_it(func() => float(t))
}
print(int("1.234".replace(".", "")), int(float("1.234")), int("1,234".replace(",", "")), int(float("1,234".replace(",", "."))))
print(int("1'000".replace("'", "")), int("1\u{a0}234".replace("\u{a0}", "")))
print(float("1\u{202f}234,5".replace("\u{202f}", "").replace(",", ".")), float("1'234.5".replace("'", "")), float("1,234.56".replace(",", "")))
let x = "\u{2212}0,5"
x = x.replace("−", "-")
print(float("\u{2212}5".replace("−", "-")), float(x.replace(",", ".")), float("12\u{66b}5".replace("٫", ".")))
// Never "'1' would work" when digits follow.
try_it(func() => int("12a34"))
// The second review of round 20: Intl's de-CH apostrophe U+2019, U+066C between thousands with
// ASCII digits, and a first group that starts with 0, which is no thousand.
for t in ["1\u{2019}000", "0.123", "0,123", "1\u{66c}234"] {
    try_it(func() => int(t))
}
for t in ["1\u{2019}234.5", "1\u{66c}234\u{66b}5"] {
    try_it(func() => float(t))
}
print(int("1\u{2019}000".replace("’", "")), int(float("0.123")), int(float("0,123".replace(",", "."))), int("1\u{66c}234".replace("٬", "")))
print(float("1\u{2019}234.5".replace("’", "")), float("1\u{66c}234\u{66b}5".replace("٬", "").replace("٫", ".")))
// The third pass of round 20: other digits with the bidi mark Intl writes before a sign (ar-EG
// U+061C, fa-IR U+200E and U+2212, ps-AF U+200E twice, ckb U+200F) and with ASCII commas between
// thousands (bn-BD, the Indian grouping, mr-IN), taken out in the block (locale_numbers.v2 runs
// them); a decimal comma, or a comma after the point, stays.
func hint_of(f) {
    try { f() } catch (e) { print(e.hint) }
}
for t in ["\u{61c}-\u{661}\u{66c}\u{662}\u{663}\u{664}\u{66b}\u{665}", "\u{200e}\u{2212}\u{6f1}\u{66c}\u{6f2}\u{6f3}\u{6f4}\u{66b}\u{6f5}", "\u{200e}-\u{200e}\u{6f1}\u{66c}\u{6f2}\u{6f3}\u{6f4}\u{66b}\u{6f5}", "\u{200f}-\u{661}\u{66c}\u{662}\u{663}\u{664}\u{66b}\u{665}"] {
    hint_of(func() => float(t))
}
for t in ["\u{9e7},\u{9e8}\u{9e9}\u{9ea}.\u{9eb}", "\u{9e7}\u{9e8},\u{9e9}\u{9ea},\u{9eb}\u{9ec}\u{9ed}.\u{9eb}", "\u{9e9},\u{9eb}", "\u{ed1}.\u{ed2}\u{ed3}\u{ed4},\u{ed5}"] {
    hint_of(func() => float(t))
}
for t in ["\u{967},\u{968}\u{969}\u{96a}", "-\u{967},\u{968}\u{969}\u{96a}.\u{96b}"] {
    hint_of(func() => int(t))
}
// A first group that starts with 0 is no thousand in grouped_hint either.
hint_of(func() => int("0 123"))
hint_of(func() => int("0\u{2019}123"))
hint_of(func() => float("0,123.5"))
print(int("0 123".replace(" ", "")))
// The fourth pass of round 20, as Node's toLocaleString writes them (locale_numbers.v2 follows
// them): a decimal comma before three digits stays, after a zero of any script (de-DE-u-nu-deva,
// fr-u-nu-beng, lo-LA-u-nu-laoo and km-KH-u-nu-khmr 0.123; the double-struck zero, right after
// the bold digits, and Brahmi's, after its twenty numbers, but not a double-struck one) or after
// four digits (es-u-nu-deva and pt-PT-u-nu-beng 1234.567).
for t in ["\u{966},\u{967}\u{968}\u{969}", "\u{9e6},\u{9e7}\u{9e8}\u{9e9}", "\u{ed0},\u{ed1}\u{ed2}\u{ed3}", "\u{17e0},\u{17e1}\u{17e2}\u{17e3}", "\u{1d7d8},\u{1d7d9}\u{1d7da}\u{1d7db}", "\u{11066},\u{11067}\u{11068}\u{11069}", "\u{1d7d9},\u{1d7da}\u{1d7db}\u{1d7dc}", "\u{967}\u{968}\u{969}\u{96a},\u{96b}\u{96c}\u{96d}", "\u{9e7}\u{9e8}\u{9e9}\u{9ea},\u{9eb}\u{9ec}\u{9ed}"] {
    hint_of(func() => float(t))
}
// For int(), a point that can be between thousands keeps the block int (de-DE-u-nu-deva,
// lo-LA-u-nu-laoo and km-KH-u-nu-khmr 1234, de-DE-u-nu-deva 1234567); one that can't, or U+066B,
// makes it float (mr-IN 12.5 and 0.123, ar-EG 1234.5).
hint_of(func() => int("\u{966},\u{967}\u{968}\u{969}"))
for t in ["\u{967}.\u{968}\u{969}\u{96a}", "\u{ed1}.\u{ed2}\u{ed3}\u{ed4}", "\u{17e1}.\u{17e2}\u{17e3}\u{17e4}", "\u{967}.\u{968}\u{969}\u{96a}.\u{96b}\u{96c}\u{96d}", "\u{967}\u{968}.\u{96b}", "\u{966}.\u{967}\u{968}\u{969}", "\u{661}\u{66c}\u{662}\u{663}\u{664}\u{66b}\u{665}"] {
    hint_of(func() => int(t))
}
// The fifth look at round 20: a sign after the bidi mark Intl writes (ar-u-nu-deva, ar-EG):
// the first group is read past both, so the commas still go.
hint_of(func() => int("\u{200e}-\u{967},\u{968}\u{969}\u{96a}.\u{96b}"))
hint_of(func() => int("\u{61c}-\u{661},\u{662}\u{663}\u{664},\u{665}\u{666}\u{667}"))
