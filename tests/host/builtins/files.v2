// read_file and write_file (DOCS 3.11, INTERNALS 5.10), in the harness's temporary home.
let home = getenv("HOME") ?? getenv("USERPROFILE")
let path = home + "/v2_files_test.txt"
print(write_file(path, "line 1\r\nline 2é\n"))
let text = read_file(path)
print(len(text), text.lines())
print(len(read_file(path, binary: true)), read_file(path, true)[0])
write_file(path, b"\xef\xbb\xbfbom\xff")
let raw = read_file(path, binary: true)
print(raw.hex())
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type + ": " + e.message.replace(home, "~"))
        if e.hint {
            print("  hint: " + e.hint)
        }
    }
}
show(func() => read_file(path))
// The OS's own text follows the path; it differs between systems.
try { read_file(home + "/missing_v2_file.txt") } catch (e) { print(e.type, e.message.replace(home, "~").split("': ")[0]) }
show(func() => write_file(path, 5))
show(func() => read_file(path, binary: "yes"))
// One leading byte-order mark is dropped from text (Windows tools write one); binary keeps it.
write_file(path, b"\xef\xbb\xbfok")
print(len(read_file(path)), read_file(path).encode().hex(), len(read_file(path, binary: true)))
// UTF-16 says so, a folder says so, and a path's control character shows escaped.
write_file(path, b"\xff\xfeh\x00i\x00")
show(func() => read_file(path))
// UTF-32 says so, with its own encoding: its little-endian mark starts with UTF-16's (round 19).
write_file(path, b"\xff\xfe\x00\x00h\x00\x00\x00")
show(func() => read_file(path))
write_file(path, b"\x00\x00\xfe\xff\x00\x00\x00h")
show(func() => read_file(path))
show(func() => read_file(home))
try { read_file(home + "\new.txt") } catch (e) { print(e.type, e.message.replace(home, "~").split("': ")[0]) }
// Invisible characters show inside containers.
print(["\u{feff}name", "a\u{200b}b"])
// UTF-8 whose last character is cut (a log another program is still writing) says so, with no
// code page's advice, which would garble it: two characters past ASCII before the cut, or a
// byte-order mark, make it UTF-8. One byte past ASCII at the end (cp1252's caf\xe9), a bad byte
// inside, a lone lead byte, or a short text in a code page that reads as one such character and a
// cut (cp1251's Пёс, cp932's ﾃｽﾄ) keeps the code page's advice (round 23).
for data in [b"started in \xc5\x81\xc3\xb3d\xc5\xba\nuser \xc5", b"\xe2\x82\xac\xe2\x82\xac and \xe2\x82", b"\xf0\x9f\x98\x80 \xf0\x9f\x98\x81 then \xf0\x9f\x98", b"\xef\xbb\xbfplain \xc5", b"caf\xe9", b"caf\xe9 au lait", b"\xc5", b"\xcf\xb8\xf1", b"\xc3\xbd\xc4"] {
    write_file(path, data)
    try { read_file(path) } catch (e) { print(e.message.replace(home, "~")) }
}
write_file(path, b"user \xc5\x81\xc3\xb3d\xc5")
show(func() => read_file(path))
