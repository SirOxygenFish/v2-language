// A path that starts with ~ and a name no user has (Word's ~WRL0001.tmp, a folder ~old) is a
// name, taken as written on every system, as no shell expands it (round 17 review, DOCS 3.11).
// ~root/x and ~nobody, users that exist, are refused on Linux and macOS (tilde_users_unix.v2).
write_file("~WRL0001.tmp", "x")
print(exists("~WRL0001.tmp"), read_file("~WRL0001.tmp"), "~WRL0001.tmp" in list_dir("."))
print(remove_file("~WRL0001.tmp"), exists("~WRL0001.tmp"))
print(exists("~old/x"), exists("~nosuchuser_v2test"), exists("~$report.docx"), exists("~1"))
try { read_file("~old/x") } catch (e) { print(e.message) }
try { write_file("~old/x", "x") } catch (e) { print(e.message, "|", e.hint) }
try { list_dir("~nosuchuser_v2test/a") } catch (e) { print(e.message) }
