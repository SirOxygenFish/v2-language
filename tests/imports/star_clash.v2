// requires: py
// A name `@import { * }` bound can't be declared again in the same body, in either order; the
// static checks can't see these names, so this is 5.6's NameError (INTERNALS 4.5, 5.6, 13.4).
func show(f) {
    try {
        print(f())
    } catch (e) {
        print(e.type, "|", e.message, "| line", e.line)
    }
}
show(func() {
    @import { * } from py.statistics
    let mean = 5
    return mean
})
show(func() {
    @import { * } from py.statistics
    @import { join as median } from py.os.path
    return median
})
show(func() {
    @import { * } from py.statistics
    const mode = 3
    return mode
})
show(func() {
    @import { * } from py.statistics
    import "fixtures/one.v2" as variance
    return variance
})
show(func() {
    let mean = 1
    @import { * } from py.statistics
    return mean
})
// An inner body may shadow a name `*` bound, and the import stays a const.
@import { * } from py.statistics
func inner() {
    let mean = "shadowed"
    return mean
}
print(inner(), mean([1, 3]))
try {
    mean = 1
} catch (e) {
    print(e.type, "|", e.message)
}
