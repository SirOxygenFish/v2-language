// requires: py
// 13.4: a name a block's `from v2` import reads doesn't wait, because it is read as a value.
@import { sqrt } from py.math
func run() {
    return sqrt(16)
}
@py {
    @import { sqrt } from v2
    print(sqrt(25))
}
print(run())
// `from v2` looks at what it finds, so `pi` has to be there by then: not a waiting reference,
// which would pass for a function, but the constant, which a block can't import (DOCS 6.2).
@import { pi } from py.math
try {
    @py {
        @import { pi } from v2
        pass
    }
} catch (e) {
    print(e.type, "|", e.message)
}
