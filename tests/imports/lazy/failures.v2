// requires: py
// R64: a block failing in the line is stored and doesn't stop the rest; the first error goes to
// what needed the language (INTERNALS 12.7).
@py bad {
    raise ValueError("boom")
    def f():
        return 1
    @export { f }
}
@py seed {
    print("seed runs")
    def s():
        return "s"
    @export { s }
}
@import { f } from bad
@import { s } from seed
print("waiting")
try {
    @py { print("never") }
} catch (e) {
    print(e.type, "|", e.foreign_type, "|", e.message)
}
@py { print("action") }
func call() {
    try {
        return f()
    } catch (e) {
        return e.message
    }
}
print(call())
print(call())
print(s())
