// requires: py js
// R17 (py and js): with stdout captured, output keeps program order across V2 and its blocks,
// also text without a newline and output around a callback (DOCS 4.6, INTERNALS 9.9), and a
// run-engine block's (17.3). The compiled part comes with Phase 2.
print("v2 1")
@py { print("py print") }
@py {
    import sys
    sys.stdout.write("py write, no newline: ")
}
print("v2 2")
@js { console.log("js log") }
@js { process.stdout.write("js write, no newline: ") }
print("v2 3")
@py(cb: func() => print("v2 inside py")) {
    print("py before")
    cb()
    print("py after")
}
@js(cb: func() => print("v2 inside js")) {
    console.log("js before");
    cb();
    console.log("js after");
}
@py(js_say: @js { (s) => console.log("js called from py: " + s) }) {
    print("py first")
    js_say("hi")
    print("py last")
}
define_engine("nd", kind: "run", command: ["node", "{file}"], ext: "js")
@nd { console.log("run engine log") }
@nd { process.stdout.write("run engine, no newline: ") }
print("v2 after run")
print("v2 end")
