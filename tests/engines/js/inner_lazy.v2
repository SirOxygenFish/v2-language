            return [e.name, e.type, e.message];
        }
    }
    @export { get }
}
@ts d {
    const LATER: number = 5;
    @export { LATER }
}
@import { get } from c
print(get())
// A name only a not yet loaded `*` block could provide goes through V2 (a route), even on this
// engine, so after the load its exceptions arrive as V2Error.
@js e {
    @import { g } from f
    function callG(x) {
        try {
            return g(x);
        } catch (err) {
            return [err.name, err.type, err.message];
