// requires: js
// R52 for JavaScript: a @js block imports from a @ts block further down, on the same engine; the
// function is looked up when called (INTERNALS 13.7).
@js a {
    @import { f } from b
    function callF(x) {
        try {
            return f(x);
        } catch (e) {
            if (e.name === "RangeError") return "RangeError: " + e.message;
            return [e.name, e.type, e.message];
        }
    }
    @export { callF }
}
@import { callF } from a
print(callF(1))
@ts b {
    const VERSION: string = "1.0";
    var f = function (x: number): number {
        if (x < 0) throw new RangeError("negative");
        return x * 10;
    };
    function rebind(): void {
        f = (x: number): any => "rebound";
    }
    @export { f, rebind, VERSION }
}
print(callF(2))
print(callF(-1))
@import { rebind } from b
rebind()
print(callF(3))
try {
    @js {
        @import { VERSION } from b
    }
} catch (e) {
    print(e.type, "|", e.message)
}
