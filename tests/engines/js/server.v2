// requires: js
// DOCS 17.6: a server in a block serves while V2 waits on its Promise, and its handlers call V2.
// The client here is JavaScript's own fetch, on the same event loop.
func greet(name) {
    return f"hello, ${name}"
}

@js web {
    @import { greet } from v2
    const http = require("http")
    function serve() {
        return new Promise((resolve) => {
            const server = http.createServer((req, res) => {
                const url = new URL(req.url, "http://127.0.0.1")
                if (url.pathname === "/stop") {
                    res.end("stopping\n")
                    server.close(() => resolve("stopped"))
                    return
                }
                res.end(greet(url.searchParams.get("name") ?? "world") + "\n")
            })
            server.listen(0, "127.0.0.1", async () => {
                const base = `http://127.0.0.1:${server.address().port}`
                for (const path of ["/?name=Ada", "/", "/stop"]) {
                    const text = await (await fetch(base + path)).text()
                    console.log(text.trim())
                }
            })
        })
    }
    @export { serve }
}
@import { serve } from web
print(serve())
