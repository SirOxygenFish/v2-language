// requires: js
// In a block of several lines whose value is used, a last line that starts with ( [ or ` would be
// read as part of the line above (`1` then `[a, 2]` is `1[a, 2]`): an error says to end that line
// with ;. With the ;, or after a }, it is the block's value (DOCS 4).
try {
    let w = @js {
        let a = 1
        [a, 2]
    }
} catch (e) {
    print(e.foreign_type, e.message)
}
let w = @js {
    let a = 1;
    [a, 2]
}
print(w)
let v = @js {
    function f() { return 1 }
    (f() + 1)
}
print(v)
// A line in the middle that JavaScript joined to the one above, found when it fails: the same
// advice as a hint (INTERNALS 12.6).
try {
    let joined = @js {
        const a = [1, 2]
        [3, 4].forEach(x => a.push(x))
        a
    }
} catch (e) {
    print(e.foreign_type, e.message)
    print(e.hint)
}
// A failing line that doesn't start so gets no such hint.
try {
    let other = @js {
        const a = null
        a.length
    }
} catch (e) {
    print(e.hint)
}
