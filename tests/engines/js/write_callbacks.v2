// requires: js
// A write's callback runs as Node runs it: in a tick of its own, in order with other ticks, the
// same callback again counted into the tick still waiting (so a block that logs a lot doesn't
// hold every line in memory until it ends), with null, and a throw loses no later one (9.9).
@js J {
    function grew(n) {
        const before = process.memoryUsage().heapUsed;
        // console.log's way, on both streams in turn: a shared callback per stream.
        const out = () => {};
        const err = () => {};
        for (let i = 0; i < n; i++) {
            process.stdout.write("", out);
            process.stderr.write("", err);
        }
        return (process.memoryUsage().heapUsed - before) / 1048576;
    }
    async function order() {
        const seen = [];
        const a = () => seen.push("a");
        process.stdout.write("", () => seen.push("w1"));
        process.nextTick(() => seen.push("tick"));
        process.stdout.write("", () => seen.push("w2"));
        for (let i = 0; i < 3; i++) process.stdout.write("", a);
        process.stdout.write("", () => { throw new Error("cb boom") });
        process.stdout.write("", (err) => seen.push(String(err)));
        // Each stream counts its own: f, f, then g, g.
        const f = () => seen.push("f");
        const g = () => seen.push("g");
        process.stdout.write("", f);
        process.stderr.write("", g);
        process.stdout.write("", f);
        process.stderr.write("", g);
        await new Promise((r) => setImmediate(r));
        return seen.join(",");
    }
    @export { grew, order }
}
@import { grew, order } from J
print(grew(300000) < 20, order())
