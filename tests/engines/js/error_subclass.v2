// requires: js
// A JS error class says what it is, as a Python one does (DOCS 3.9, 10).
func kind(f) {
    try {
        f()
    } catch (e) {
        return e.foreign_type
    }
}
@js {
    class AppErr extends Error {}
    class Named extends Error {
        constructor(m) {
            super(m);
            this.name = "CustomName";
        }
    }
    function a() { throw new AppErr("x") }
    function b() { throw new Named("x") }
    function c() { throw new Error("x") }
    function d() { throw new TypeError("x") }
    class SubType extends TypeError {}
    class SetsError extends Error {
        constructor(m) {
            super(m);
            this.name = "Error";
        }
    }
    function e() { throw new SubType("x") }
    function f() { throw new SetsError("x") }
    function g() {
        const x = new Error("x");
        x.name = "CustomName";
        Object.defineProperty(x, "constructor", { get() { throw new Error("no") } });
        throw x;
    }
    function h() { throw { name: "Error", message: "x" } }
    class MyAbort extends DOMException {}
    function i() { throw new MyAbort("x", "AbortError") }
    @export { a, b, c, d, e, f, g, h, i }
}
@import { a, b, c, d, e, f, g, h, i } from @js
print(kind(a), kind(b), kind(c), kind(d))
print(kind(e), kind(f), kind(g), kind(h), kind(i))
