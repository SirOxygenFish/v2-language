// requires: py
// A call that fails before any user code runs has only adapter frames, and those stay out of
// e.trace (12.6, 14.2).
@py {
    def f(a):
        return a
    @export { f }
}
@import { f } from @py
try {
    f(1, 2)
} catch (e) {
    print(e.foreign_type, "|", e.message, "|", e.trace)
}
try {
    f(zz: 1)
} catch (e) {
    print(e.foreign_type, "|", e.message, "|", e.trace)
}
