// requires: py
// A block imports functions from v2; a value that isn't one is a constant (DOCS 6.2).
const LIMIT = 10
func twice(x) {
    return x * 2
}
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type, "|", e.message)
    }
}
show(func() {
    @py {
        @import { LIMIT } from v2
        print(LIMIT)
    }
})
@py {
    @import { twice } from v2
    print(twice(4))
}
// A let that holds data is data too; one that holds null may get a function before the call.
let k = 5
let later = null
show(func() {
    @py {
        @import { k } from v2
        print(k)
    }
})
@py {
    @import { later } from v2
    def go():
        return later(2)
    @export { go }
}
@import { go } from @py
later = twice
print(go())
