// requires: py
// 5.6: a body that directly makes a closure keeps its own frame, so the closure's cycle goes by
// that frame. `f` keeps the closure its `if` body made, so leaving `f` checks the cycle (5.1)
// and frees it, `h` with it.
@py tools {
    class Held:
        def __del__(self):
            print("freed")
    @export { Held }
}
@import { Held } from tools
func f() {
    let h = Held()
    let g = null
    if true {
        g = func() => 1
    }
}
f()
// The release goes out with the next request, before it, so `__del__` prints first.
@py { pass }
print("after")
