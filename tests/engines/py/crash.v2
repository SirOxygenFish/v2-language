// requires: py
// R18: a worker that dies during a call: EngineCrashed naming its exit status, then "is not
// running" at the next call; the script goes on (INTERNALS 8.2, 8.6).
func show(f) {
    try {
        f()
    } catch (e) {
        print(e.type, "|", e.message.starts_with("engine 'py' (pid "), "|", e.message.split(") exited")[-1])
    }
}
@py dies {
    import os
    def die():
        os._exit(3)
    def fine():
        return 1
    @export { die, fine }
}
@import { die, fine } from dies
show(die)
try {
    fine()
} catch (e) {
    print(e.type, "|", e.message)
}
print("the script continues")
