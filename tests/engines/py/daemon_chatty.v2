// requires: py
// platform: unix
// timeout: 6
// A daemon that keeps writing to a worker's pipe doesn't hide the worker's death (8.5).
try {
    @py {
        import os, sys, time
        if os.fork() == 0:
            os.setsid()
            for i in range(90):
                sys.stderr.write("tick\n")
                sys.stderr.flush()
                time.sleep(0.1)
            os._exit(0)
        time.sleep(0.3)
        os._exit(2)
    }
} catch (e) {
    print(e.type)
}
