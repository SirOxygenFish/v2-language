// requires: py
// timeout: 60
// A returned closure that its frame keeps twice is freed by the next collection, not at once;
// collections come sooner the more the frames hold, so objects with big data never pile up
// (INTERNALS 5.1).
@py pk {
    freed = [0]
    class Tracked:
        def __del__(self):
            freed[0] += 1
    def make():
        return Tracked()
    def n():
        return freed[0]
    @export { make, n }
}
@import { make, n } from pk
func two_slots(i) {
    let t = make()
    let pad = range(0, 20000)
    let f = func() => len(pad)
    let g = f
    return f
}
n()
let before = n()
for i in 0..200 {
    let f = two_slots(i)
    f()
}
n()
print(n() - before >= 190)
