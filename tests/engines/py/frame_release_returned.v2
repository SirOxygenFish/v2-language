// requires: py
// A returned closure, once dropped, frees its frame at the next scope exit, not at a sweep many
// frames later (INTERNALS 5.1).
@py pk {
    freed = [0]
    class Tracked:
        def __del__(self):
            freed[0] += 1
    def make():
        return Tracked()
    def n():
        return freed[0]
    @export { make, n }
}
@import { make, n } from pk
func make_local(i) {
    let t = make()
    let get = func() => t
    return get
}
func nop() {
    return null
}
n()
let before = n()
for i in 0..40 {
    let f = make_local(i)
    f()
}
nop()
n()
print(n() - before)
