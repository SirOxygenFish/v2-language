// requires: py
// An @export name that Python reads in its NFKC form, so the block defines another name, says
// which name to export and how to import it (INTERNALS 12.2, round 20), as block args do.
try {
    @py p {
        def ｈｅｌｌｏ():
            return "hi"
        @export { ｈｅｌｌｏ }
    }
} catch (e) {
    print(e.type, "|", e.message)
}
// One character that changes: its code point alone. A block without a label is imported from @py
// (DOCS 6.2; round 20's review).
try {
    @py {
        ﬁle = 1
        @export { ﬁle }
    }
} catch (e) {
    print(e.message.split(" (")[1])
    print(e.message.split(" import it as ")[1])
}
// What the message says works.
@py q {
    def ｈｅｌｌｏ():
        return "hi"
    @export { hello }
}
@import { hello as ｈｅｌｌｏ } from q
print(ｈｅｌｌｏ())
@py {
    ﬁle = 1
    @export { file }
}
@import { file as ﬁle } from @py
print(ﬁle)
// Only a block whose top level, read as Python reads names, defines that name (an assignment
// too) gets that wording; else the plain message (round 20's review).
try {
    @py s {
        x = 1
        @export { ｈｅｌｌｏ }
    }
} catch (e) {
    print(e.message)
}
try {
    @py t {
        ｗｏｒｌｄ: int = 2
        @export { ｗｏｒｌｄ }
    }
} catch (e) {
    print(e.message.split(", which ")[1])
}
// Any mention of the name Python reads counts, so each way Python defines one gets that wording
// (round 20, third pass): a tuple assignment, import-as, for, with, under an if. A longer name
// that holds it (`files`) is no mention.
try {
    @py tup {
        ﬁle, n = 1, 2
        @export { ﬁle }
    }
} catch (e) {
    print(e.message)
}
try {
    @py imp {
        from os import sep as ﬁle
        @export { ﬁle }
    }
} catch (e) {
    print(e.message)
}
try {
    @py loop {
        for ﬁle in [1]:
            pass
        @export { ﬁle }
    }
} catch (e) {
    print(e.message)
}
try {
    @py ctx {
        import contextlib
        with contextlib.nullcontext(1) as ﬁle:
            pass
        @export { ﬁle }
    }
} catch (e) {
    print(e.message)
}
try {
    @py cond {
        if True:
            ｈｅｌｌｏ = 1
        @export { ｈｅｌｌｏ }
    }
} catch (e) {
    print(e.message)
}
try {
    @py none {
        ﬁles = [1]
        @export { ﬁle }
    }
} catch (e) {
    print(e.message)
}
// Followed, those work.
@py loop2 {
    for ｃｏｕｎｔ in [7]:
        pass
    @export { count }
}
@import { count as ｃｏｕｎｔ } from loop2
print(ｃｏｕｎｔ)
@py imp2 {
    from string import digits as ｄｉｇｉｔｓ
    @export { digits }
}
@import { digits as ｄｉｇｉｔｓ } from imp2
print(ｄｉｇｉｔｓ)
// An export one accent away gets its did-you-mean (5.9).
@py r {
    def büyüt(s):
        return s.upper()
    @export { büyüt }
}
try {
    @import { buyut } from r
} catch (e) {
    print(e.type, "|", e.message)
}
