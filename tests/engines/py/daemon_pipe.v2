// requires: py
// platform: unix
// timeout: 6
// A daemon that keeps a worker's pipe doesn't hide the worker's death (8.5).
@py {
    import os, time
    if os.fork() == 0:
        os.setsid()
        if os.fork() == 0:
            time.sleep(9)
            os._exit(0)
        os._exit(0)
    time.sleep(0.2)
}
print("daemon started")
try {
    @py {
        import os
        os._exit(3)
    }
} catch (e) {
    print(e.type)
}
