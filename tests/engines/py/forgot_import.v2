// requires: py
// A block's export used without its @import, or before it, a block's label used as a name, and a
// label written where an engine's tag goes (INTERNALS 5.6, 5.9, 13.3).
@py tools {
    def spread(xs):
        return max(xs) - min(xs)
    def first(xs):
        return xs[0]
    @export { spread, first }
}
@py {
    def f():
        return 1
    @export { f }
}
try { print(first([1, 5])) } catch (e) { print(e.message) }
try { print(spread([1, 5])) } catch (e) { print(e.message) }
try { print(tools.spread([1, 5])) } catch (e) { print(e.message) }
try { print(f()) } catch (e) { print(e.message) }
try {
    @import { f } from py
    print(f())
} catch (e) {
    print(e.message)
}
@import { spread } from tools
print(spread([1, 5]))
