// requires: py js
// DOCS 7.
func err(f) {
    try {
        return str(f())
    } catch (e) {
        return f"${e.type}: ${e.message}"
    }
}
func kind(f) {
    try {
        return str(f())
    } catch (e) {
        return e.type
    }
}
@import { mean, median } from py.statistics
@import { join } from py.os.path
@import { basename } from js.path
@import py.json as pyjson
print(mean([1, 2, 3, 4]), median([1, 3, 2]), basename("a/b.txt"), pyjson.dumps({"a": 1}))
print(join("a", "b") in ["a/b", "a\\b"])
print(err(func() {
    @import { x } from py.v2_no_such_module
    return x
}))
print(err(func() {
    @import { nope } from py.statistics
    return nope
}))
print(kind(func() {
    @import { x } from js."v2-no-such-pkg"
    return x
}))
print(err(func() {
    @import { x } from py."os; print(1)"
    return x
}))
@import py.math as m
print(m.pi > 3, m.floor(2.5), type(m), type(m.floor))
print(err(func() => m.nope))
@import { sep } from js.path
print(sep == "/" || sep == "\\")
