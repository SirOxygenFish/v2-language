// requires: py
// stderr: below the language level
// DOCS 5, Python; 4.5; 4.6.
@py {
    def plot(xs, color="blue", *, width=1):
        return [len(xs), color, width]
    async def later(x):
        return x + 1
    async def twice(x):
        return (await later(x)) * 2
    def name():
        return __name__
    def leave():
        import sys
        sys.exit(3)
    @export { plot, later, twice, name, leave }
}
@import { plot, later, twice, name, leave } from @py
print(plot([1, 2], color: "red"), plot([1], width: 2), plot([]))
print(later(1), twice(1))
print(name() == "__main__", type(name()))
try {
    leave()
} catch (e) {
    print(e.type, e.foreign_type, e.message)
}
print(@py { 1 + 1 })
print(@py {
    a = 2
    a * 21
})
print(@py { print("héllo ✓ 日本語") })
let v = @py { x = 1 }
print(v)
let data = [3, 1, 2]
print(@py(data) { sum(data) / len(data) })
print((@py { 1 }) + 2, (@py { "ada" }).upper())
let when = @py {
    import datetime
    datetime.date(2024, 5, 6)
}
print(when.year, type(when))
for i in 0..3 {
    @py(i) { print("action run", i) }
}
@py counter {
    count = 0
    def bump():
        global count
        count += 1
        return count
    @export { bump }
}
@import { bump } from counter
bump()
print(bump())
@py {
    import os
    os.system("echo below the language level")
}
print("after")
