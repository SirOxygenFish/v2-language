// DOCS 3.2, 3.4, 3.11; INTERNALS 5.2, 5.3, 5.10.
func err(f) {
    try {
        return str(f())
    } catch (e) {
        return f"${e.type}: ${e.message}"
    }
}
func kind(f) {
    try {
        return str(f())
    } catch (e) {
        return e.type
    }
}
print(1_000_000, 0xff, -7, 3.14, 1e-3, 2.0, 0.1 + 0.2 == 0.3)
