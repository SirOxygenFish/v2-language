print(min(3, 1, 2), max([1, 5, 2]), min("b", "a"), max(1, 2.5), min(1, 1.0), max(1.0, 1), min([7]))
print(range(3), range(1, 4), range(5, 0, -2), range(0), range(2, 2))
print(0 || "x", 1 && 2, null ?? 3, 0 ?? 3, false ? 1 : 2, !0, 1 not in [1], 2 in [1, 2])
