let b = a.copy()
b[0].push(2)
b.push(3)
print(a, b)
let c = [1]
let d = c
c += [2]
print(c, d)
let l = [1, 2]
l[-1] = 9
l[0] += 1
print(l, [1] + [2], [0] * 3, 2 * [1], [1] * 0)
const fixed = [1]
fixed.push(2)
print(fixed)
let u = {name: "Ada", "favorite number": 7, ["com" + "puted"]: 1}
print(u)
u.email = "x"
u["name"] = "B"
print(u.keys(), u.values())
print(u.get("phone", "none"), u.get("phone"), u.remove("computed"), len(u), "email" in u, 1 in u, u.name, u["favorite number"])
let o = {keys: func() => "mine", n: 1}
print(o.keys(), {values: 3}.values(), {}.keys())
let cyc = []
cyc.push(cyc)
print(cyc)
let dcyc = {}
dcyc.self = dcyc
print(dcyc)
let n = null
print(n?.a.b.c, n?.a(), {a: null}.a?.b, n?.a ?? "fallback")
print(err(func() => [].pop()))
print(err(func() => [1].pop(9)))
print(err(func() => [1][5]))
print(err(func() => [1][1.0]))
print(err(func() => [1].x))
print(err(func() => {}.x))
print(err(func() => {}["x"]))
print(err(func() => {}[1]))
print(err(func() => [1, "a"].sort()))
print(err(func() => [[1]].sort()))
print(err(func() => null.x))
print(err(func() => null[0]))
print(err(func() => 5[0]))
print(err(func() => {a: null}.a.b))
print(kind(func() => [1].append(2)), kind(func() => {a: 1}.remove("b")), kind(func() => [1, 2].join(1)))
