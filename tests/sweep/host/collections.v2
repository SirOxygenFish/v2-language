// DOCS 3.6, 3.7; INTERNALS 5.5, 5.11.
func err(f) {
    try {
        return str(f())
    } catch (e) {
        return f"${e.type}: ${e.message}"
    }
}
func kind(f) {
    try {
        return str(f())
    } catch (e) {
        return e.type
    }
}
let xs = [5, 3, 8]
xs.push(1)
print(xs, xs.pop())
xs.sort()
print(xs, xs[0], xs[-1], xs[0:2], xs[:1], xs[-1:])
xs.push()
xs.push(7, 9)
xs.push(...[1, 2])
print(xs)
print(xs.pop(0), xs.pop(-2), xs)
xs.insert(1, 0)
xs.insert(-1, 6)
xs.insert(100, 4)
xs.insert(-100, 2)
print(xs)
xs.reverse()
print(xs[0], xs[-1], len(xs))
let ps = [{n: "a", v: 2}, {n: "b", v: 1}, {n: "c", v: 2}]
ps.sort(key: func(p) => p.v)
print(ps.map(func(p) => p.n))
ps.sort(key: func(p) => p.v, reverse: true)
print(ps.map(func(p) => p.n))
let mixed = [3, float("nan"), 1.5, 2]
mixed.sort()
print(mixed)
let words = ["b", "C", "a"]
words.sort(reverse: true)
print(words)
print([1, 2, 3].map(func(x) => x * 2), [1, 2, 3].filter(func(x) => x % 2 == 1), [1, "a", 2.5, null].join("-"), [1, [2]].index_of([2]), [1].index_of(9), [1].get(5), [1].get(5, "d"), [1, 2].get(-1))
