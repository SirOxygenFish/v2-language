// DOCS 3.5; INTERNALS 5.4, 5.11.
func err(f) {
    try {
        return str(f())
    } catch (e) {
        return f"${e.type}: ${e.message}"
    }
}
func kind(f) {
    try {
        return str(f())
    } catch (e) {
        return e.type
    }
}
let name = "Ada"
print(f"Hello, ${name}! 2 + 2 = ${2 + 2}")
print(f"${19.999:.2f}", f"${3:.1f}", f"${float("nan"):.2f}", f"${[1, "a"]}", f"\${x}", f"${{a: 1}.a}")
