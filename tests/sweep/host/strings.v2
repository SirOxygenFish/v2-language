print(err(func() => "hello"[9]))
print(err(func() => 1 in "abc"))
print(err(func() => "a" in 5))
print(err(func() => "abc".split("")))
print(err(func() => "a".replace("", "x")))
print(err(func() => b"\xff".decode()))
print(err(func() => "abc".nope()))
