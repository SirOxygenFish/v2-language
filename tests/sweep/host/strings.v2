let b = "hé".encode()
print(b, len(b), b[0], b[-1], b[0:1], b.decode(), b.hex(), 104 in b, b"h" in b, 300 in b, b + b"!")
print(b"\x00A\xff", b"\"\\\n", type(b), b == "hé".encode(), b[1:] == b"\xc3\xa9")
print("ell" in "hello", "z" not in "hello", "ab" * 3, 2 * "ab", "ab" * 0 == "", "ab" * -1 == "")
for ch in "hé" {
