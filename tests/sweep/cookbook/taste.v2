// requires: py js
// DOCS 4.3 and 4.4.
let nums = [4, 8, 15, 16, 23, 42]
@py(nums, label: "lucky numbers") {
    print(label, "->", sum(nums))
}
for i in 0..3 {
    @py(i) { print("action run", i) }
}
@py counter {
    count = 0
    def bump():
        global count
        count += 1
        return count
    @export { bump }
}
@import { bump } from counter
bump()
print(bump())
